{
    "features": {
        "hide-ads": {
            "enabled": true
        },
        "related-section": {
            "enabled": true,
            "sub": {
                "remove-extras": {
                    "enabled": true,
                    "sub": {
                        "keep-shorts": {
                            "enabled": true
                        }
                    }
                }
            }
        },
        "dynamic-player": {
            "enabled": true,
            "sub": {
                "sticky": {
                    "enabled": true
                }
            },
            "min-height": "200px"
        }
    },
    "variables": {
        "--bg-buttons": "#333",
        "--bg-buttons-highlighted": "#ddd",
        "--primary-color": "#f48",
        "--secondary-color": "#400",
        "--tint-transparent": "#4484",
        "--app-bg": "#112",
        "--roundedness": "4px",

        "--item-padding": "8px",
        "--item-margin": "0px",
        "--item-background-color": "none",
        "--item-background-color-hover": "#4468",
        "--item-border": "none",
        "--item-border-hover": "none",

        "--section-bg": "#224",
        "--button-roundedness": "8px",
        "--border-style": "2px solid #66ad",
        "--section-spacing": "8px",
        "--space-below-main-player": "32px",
        "--spacings-gaps": "4px",

        "--text-primary": "#aaaaaa",
        "--text-primary-hover": "#ffffff",
        "--text-secondary": "#666666",
        "--text-secondary-hover": "#888888",
        "--text-header": "#fff",
        "--text-creator": "#888",
        "--text-info": "#888",
        "--text-links": "#22f",
        "--text-names": "#ddd",
        "--text-comment": "#ddd",
        "--text-buttons": "#ddd",
        "--text-buttons-highlighted": "#222",

        "--trans-time-short": "0.1s",
        "--trans-time-medium": "0.3s",
        "--trans-time-long": "0.5s",

        "--header-primary-color": "20, 20, 20",
        "--header-secondary-color": "#8800ff",
        "--header-height": "58px",

        "--comments-spacing": "4px",
        "--comments-padding": "16px",
        "--comments-margin": "0px",
        "--comments-background-color": "var(--item-background-color)",
        "--comments-background-color-hover": "var(--item-background-color-hover)",
        "--comments-border": "var(--item-border)",
        "--comments-border-hover": "var(--item-border-hover)",

        "--related-item-padding": "8px",
        "--related-video-padding": "12px",
        "--related-item-spacing": "4px",
        "--related-video-background-color": "none",
        "--related-video-background-color-hover": "var(--item-background-color-hover)",
        "--related-video-border": "var(--item-border)",
        "--related-video-border-hover": "var(--item-border-hover)",
        
        "--tag-spacing": "8px",
        "--tag-container-padding": "8px",
        "--tag-related-padding": "8px"
	}
}